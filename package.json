{
  "name": "seena-exams",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @seena/web db:generate",
    "db:migrate": "pnpm --filter @seena/web db:migrate",
    "db:studio": "pnpm --filter @seena/web db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
