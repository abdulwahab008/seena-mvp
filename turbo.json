{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.*.local"],
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "OPENROUTER_MODEL",
    "OPENROUTER_EMBEDDING_MODEL",
    "OPENROUTER_RERANK_MODEL",
    "OPENROUTER_VISION_MODEL",
    "OPENROUTER_APP_NAME",
    "OPENROUTER_APP_URL",
    "WORKER_CONCURRENCY",
    "PINECONE_API_KEY",
    "PINECONE_INDEX",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_BUCKET",
    "GOOGLE_DOCUMENT_AI_PROJECT",
    "GOOGLE_DOCUMENT_AI_LOCATION",
    "GOOGLE_DOCUMENT_AI_PROCESSOR",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "SENTRY_DSN",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NODE_ENV"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
