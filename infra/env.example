# --- Database ---
DATABASE_URL=postgresql://seena:seena@localhost:5433/seena

# --- Redis (queue) ---
REDIS_URL=redis://localhost:6380

# --- Clerk (auth) ---
# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- OpenRouter (chat completions + embeddings) ---
# One key for both LLM (Claude/GPT/etc.) and embeddings.
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
OPENROUTER_APP_NAME=Seena Exams
OPENROUTER_APP_URL=http://localhost:3000

# --- Pinecone (vector DB) ---
# Create a serverless index with dimension=3072 for text-embedding-3-large.
PINECONE_API_KEY=pcn_xxx
PINECONE_INDEX=seena-exams

# --- Supabase (storage + optional Postgres) ---
# Storage is required (for book uploads). Postgres can be Supabase or your own.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
SUPABASE_BUCKET=books

# --- Google Document AI (optional, for OCR fallback on scanned PDFs) ---
# If unset, books with low text density will still process but quality may suffer.
GOOGLE_DOCUMENT_AI_PROJECT=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Observability (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Worker tuning ---
WORKER_CONCURRENCY=2

NODE_ENV=development
