    "bullmq": "^5.34.4",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "typescript": "^5.7.3"
