    "typecheck": "tsc --noEmit",
    "backfill:labels": "tsx --env-file=.env src/scripts/backfill-exercise-labels.ts"
  },
  "dependencies": {
    "@google-cloud/documentai": "^9.0.0",
    "@pinecone-database/pinecone": "^4.0.0",
    "@seena/shared": "workspace:*",
