{
  "name": "@seena/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "start:local": "tsx --env-file=.env src/index.ts",
