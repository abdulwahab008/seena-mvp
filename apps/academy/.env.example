# Local dev: run `pnpm db:start` (supabase start) and copy its printed
# "Project URL" / "Publishable" / "Secret" values below, or just copy .env.local
# from a teammate — the local stack's keys are fixed by supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bootstrap-only secret gating /admin/provision until a real super_admin
# auth surface exists. Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_SETUP_TOKEN=

# Transactional email. Server-side only — this key must never appear in a
# NEXT_PUBLIC_* var, in client code, or in a commit. Get one at resend.com.
RESEND_API_KEY=
# Must be a domain verified in Resend; onboarding@resend.dev works for testing.
EMAIL_FROM=Seena Academy <onboarding@resend.dev>
# Absolute base URL used to build password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3011
